---
import { LuArrowUpRight, LuGithub } from "react-icons/lu";

interface Props {
  href: string;
  name: string;
  description: string;
}

const { href, name, description } = Astro.props;
---

<a class="repository-card" href={href}>
  <span class="repository-icon" aria-hidden="true">
    <LuGithub size={22} className="ui-icon" focusable="false" />
  </span>
  <span class="repository-content">
    <span class="repository-label">GITHUB REPOSITORY</span>
    <strong>{name}</strong>
    <span class="repository-description">{description}</span>
  </span>
  <LuArrowUpRight size={20} className="repository-arrow" aria-hidden="true" focusable="false" />
</a>

<style>
  .repository-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin: 1.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--mauve);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease, transform 150ms ease;
  }
  .repository-card:hover {
    background: color-mix(in srgb, var(--mauve) 10%, transparent);
    transform: translateY(-2px);
  }
  .repository-card:focus-visible {
    outline: 2px solid var(--mauve);
    outline-offset: 4px;
  }
  .repository-icon, .repository-arrow { color: var(--mauve); flex-shrink: 0; }
  .repository-content { display: grid; gap: 0.2rem; flex: 1; min-width: 0; }
  .repository-label { color: var(--mauve); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; }
  .repository-content strong { font-size: 1.1rem; }
  .repository-description { font-size: 0.9rem; line-height: 1.5; }
  @media (prefers-reduced-motion: reduce) {
    .repository-card { transition: none; }
    .repository-card:hover { transform: none; }
  }
</style>
