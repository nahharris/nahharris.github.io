---
import { LuArrowRight } from "react-icons/lu";
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>This page has moved | Hannah Harrisonn</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target.split("?")[0], Astro.site)} />
    <meta http-equiv="refresh" content={"0;url=" + target} />
  </head>
  <body>
    <p>
      This page has moved.{" "}
      <a href={target}>
        Continue to the new page{" "}
        <LuArrowRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
      </a>
    </p>
    <script is:inline define:vars={{ target }}>
      const destination = new URL(target, location.origin);
      for (const [key, value] of new URLSearchParams(location.search))
        if (!destination.searchParams.has(key)) destination.searchParams.set(key, value);
      destination.hash = location.hash;
      location.replace(destination.href);
    </script>
  </body>
</html>
