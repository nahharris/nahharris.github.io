---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import {
  LuArrowLeft,
  LuArrowRight,
  LuArrowUp,
  LuArrowUpRight,
  LuChevronDown,
} from "react-icons/lu";

import portrait from "../assets/hannah-portrait-tropical.png";
import Chapters from "../components/ChapterList.astro";
import {
  seriesPosts,
  seriesUrl,
  postUrl,
  shortTitle,
  dateLabel,
  languageLabel,
  postTranslations,
  translationUrl,
} from "../lib/series";
import type { Post, Translation } from "../lib/series";
import Layout from "./SiteLayout.astro";
interface Props {
  post: Post;
  translation?: Translation;
}
const { post, translation } = Astro.props;
const data = translation ? { ...post.data, ...translation.data } : post.data;
const translations = await postTranslations(post);
const series = (await getEntry(data.series))!;
const chapters = await seriesPosts(series.id);
const index = chapters.findIndex((p) => p.id === post.id);
const previous = chapters[index - 1];
const next = chapters[index + 1];
---

<Layout
  title={shortTitle(data.title) + " | Hannah Harrisonn"}
  description={data.description}
  article
>
  <div class="page-wrap article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/feed/">Feed</a>
      <span aria-hidden="true">/</span>
      <a href={seriesUrl(series)}>{series.data.title}</a>
      <span aria-hidden="true">/</span>
      <span>Post {index + 1}</span>
    </nav>
    <header class="article-heading">
      <div class="article-info">
        <time datetime={data.pubDate.toISOString()}>{dateLabel(data.pubDate)}</time>
        <span>{languageLabel(data.language)}</span>
        <span>
          POST {index + 1} OF {chapters.length}
        </span>
      </div>
      <h1 lang={data.language}>{shortTitle(data.title)}</h1>
      <p class="lede" lang={data.language}>
        {data.description}
      </p>
      {translations.length > 0 && (
        <nav class="article-languages" aria-label="Available languages">
          <span>Read in:</span>
          <a
            href={postUrl(post)}
            lang={post.data.language}
            aria-current={!translation ? "page" : undefined}
          >
            {languageLabel(post.data.language)}
          </a>
          {translations.map((t) => (
            <a
              href={translationUrl(post, t.data.language)}
              lang={t.data.language}
              aria-current={translation?.id === t.id ? "page" : undefined}
            >
              {languageLabel(t.data.language)}
            </a>
          ))}
        </nav>
      )}
      <div class="byline">
        <Image
          src={portrait}
          format="webp"
          quality={90}
          densities={[1, 2]}
          alt=""
          width="36"
          height="36"
        />
        <a href="/me/">
          Hannah Harrisonn <small>Engineer & curious human</small>
        </a>
        {data.updatedDate && (
          <time datetime={data.updatedDate.toISOString()}>
            Updated {dateLabel(data.updatedDate)}
          </time>
        )}
      </div>
    </header>
    <div class="reading-grid">
      <article class="article-document" lang={data.language}>
        <div class="article-body">
          <slot />
        </div>
        <div class="article-tags">
          {data.tags.map((tag) => (
            <a href={"/feed/?tag=" + encodeURIComponent(tag)}>#{tag}</a>
          ))}
        </div>
        <nav class="chapter-navigation" aria-label="Post navigation">
          {previous ? (
            <a rel="prev" href={postUrl(previous)}>
              <span>
                <LuArrowLeft size="1em" className="ui-icon" aria-hidden="true" focusable="false" />{" "}
                PREVIOUS POST
              </span>
              <strong lang={previous.data.language}>{shortTitle(previous.data.title)}</strong>
            </a>
          ) : (
            <a href={seriesUrl(series)}>
              <span>
                <LuArrowUp size="1em" className="ui-icon" aria-hidden="true" focusable="false" />{" "}
                SERIES OVERVIEW
              </span>
              <strong>{series.data.title}</strong>
            </a>
          )}
          {next ? (
            <a rel="next" href={postUrl(next)}>
              <span>
                NEXT POST{" "}
                <LuArrowRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
              </span>
              <strong lang={next.data.language}>{shortTitle(next.data.title)}</strong>
            </a>
          ) : (
            <a href={seriesUrl(series)}>
              <span>THAT'S THE LATEST POST</span>
              <strong>
                Back to {series.data.title}{" "}
                <LuArrowUpRight
                  size="1em"
                  className="ui-icon"
                  aria-hidden="true"
                  focusable="false"
                />
              </strong>
            </a>
          )}
        </nav>
      </article>
      <aside class="reader-aside">
        <details class="post-directory" open>
          <summary>
            <span>IN THIS SERIES</span>
            <strong>{series.data.title}</strong>
            <small>
              {chapters.length} {chapters.length === 1 ? "post" : "posts"}{" "}
              <span aria-hidden="true">
                <LuChevronDown
                  size="1em"
                  className="ui-icon"
                  aria-hidden="true"
                  focusable="false"
                />
              </span>
            </small>
          </summary>
          <Chapters posts={chapters} currentId={post.id} />
          <a class="all-chapters" href={seriesUrl(series)}>
            Series overview{" "}
            <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
          </a>
        </details>
      </aside>
    </div>
  </div>
</Layout>
