---
import { LuArrowRight, LuArrowUpRight } from "react-icons/lu";

import Layout from "../layouts/SiteLayout.astro";
---

<Layout title="Page not found — Hannah Harrisonn">
  <section class="page-wrap not-found">
    <p class="eyebrow">A SMALL DETOUR / 404</p>
    <h1>
      This trail
      <br />
      <em>ends here.</em>
    </h1>
    <p>The page you're looking for isn't here. Let's get you back to something interesting.</p>
    <a class="action primary" href="/feed/">
      Explore the feed{" "}
      <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
    </a>
    <a class="text-link" href="/">
      Back home <LuArrowRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
    </a>
  </section>
</Layout>
