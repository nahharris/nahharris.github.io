---
import { Image } from "astro:assets";
import {
  LuArrowRight,
  LuArrowUpRight,
  LuCircle,
  LuGlobe,
  LuInfinity,
  LuSparkles,
  LuSquare,
} from "react-icons/lu";

import portrait from "../assets/hannah-portrait-tropical.png";
import Entry from "../components/FeedEntry.astro";
import Layout from "../layouts/SiteLayout.astro";
import { contentIndex, feedItems, seriesUrl } from "../lib/series";
const [index, entries] = await Promise.all([contentIndex(), feedItems()]);
const featured = ["patch-hub", "actor-model"].map((id) =>
  index.series.find((s) => s.entry.id === id)!,
);
---

<Layout>
  <div class="home-wrap new-home">
    <section class="workshop-hero" aria-labelledby="welcome-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <LuCircle
            size={8}
            className="status-dot ui-icon"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          />{" "}
          HELLO, INTERNET. I'M HANNAH.
        </p>
        <h1 id="welcome-title">
          Always building.
          <br />
          Still <em>curious.</em>
          <span class="hero-spark" aria-hidden="true">
            <LuSparkles size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
          </span>
        </h1>
        <p class="hero-description">
          An engineer, an open-source explorer, and a collector of interesting problems. This is
          where I share the things I make and learn.
        </p>
        <div class="hero-actions">
          <a class="action primary" href="/feed/">
            Explore the feed{" "}
            <span aria-hidden="true">
              <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
            </span>
          </a>
          <a class="hero-secondary" href="/me/">
            Meet the human{" "}
            <span aria-hidden="true">
              <LuArrowRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
            </span>
          </a>
        </div>
        <p class="hero-location">
          <span aria-hidden="true">
            <LuGlobe size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
          </span>{" "}
          BASED IN BRAZIL · AT HOME ON THE INTERNET
        </p>
      </div>
      <figure class="hero-scene">
        <div class="scene-title">
          <span>
            <LuSquare
              size={7}
              className="scene-indicator ui-icon"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            />{" "}
            THE WORKSHOP / AFTER HOURS
          </span>
          <span>
            01—
            <LuInfinity size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
          </span>
        </div>
        <img
          src="/art/workshop.svg"
          width="480"
          height="350"
          alt="A pixel-art workspace with computers, a plant, and a window overlooking a futuristic city at night"
          fetchpriority="high"
        />
        <figcaption>
          <span>A place for ideas to become things.</span>
          <span aria-hidden="true">
            <LuSparkles size="1em" className="ui-icon" aria-hidden="true" focusable="false" />{" "}
            <LuSparkles size="1em" className="ui-icon" aria-hidden="true" focusable="false" />{" "}
            <LuSparkles size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
          </span>
        </figcaption>
      </figure>
    </section>
    <div class="home-intro-strip">
      <p>Projects have a home. Posts tell their story.</p>
      <a href="/feed/">
        {index.series.length} projects & series{" "}
        <span aria-hidden="true">
          <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
        </span>
      </a>
      <a href="/feed/?type=post">
        {index.posts.length} posts{" "}
        <span aria-hidden="true">
          <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
        </span>
      </a>
    </div>
    <section class="home-series">
      <div class="section-title">
        <div>
          <span class="section-index">PICK A THREAD</span>
          <h2>A good place to start.</h2>
        </div>
        <a class="text-link" href="/feed/?type=series">
          All series{" "}
          <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
        </a>
      </div>
      <div class="series-cards">
        {featured.map(({ entry, posts }) => (
          <a
            class="series-card"
            href={seriesUrl(entry)}
            style={"--series-color:var(--" + entry.data.color + ")"}
          >
            <div class="series-card-cover">
              <img src={entry.data.heroImage} alt="" width="800" height="450" loading="lazy" />
              <span>
                {posts.length ? "SERIES" : "PROJECT"}{" "}
                {posts.length > 0 && (
                  <span>
                    {posts.length} {posts.length === 1 ? "POST" : "POSTS"}
                  </span>
                )}
              </span>
            </div>
            <div class="series-card-copy">
              <h3>
                {entry.data.title}
                <span aria-hidden="true">
                  <LuArrowUpRight
                    size="1em"
                    className="ui-icon"
                    aria-hidden="true"
                    focusable="false"
                  />
                </span>
              </h3>
              <p>{entry.data.description}</p>
              <div>
                {entry.data.tags.slice(0, 3).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
    <section class="home-latest">
      <div class="section-title">
        <div>
          <span class="section-index">FRESH FROM THE WORKSHOP</span>
          <h2>The latest updates.</h2>
        </div>
        <a class="text-link" href="/feed/">
          The whole feed{" "}
          <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
        </a>
      </div>
      {entries.slice(0, 4).map((entry) => (
        <Entry entry={entry} />
      ))}
    </section>
    <section class="home-me">
      <div class="home-me-avatar">
        <Image
          src={portrait}
          format="webp"
          quality={90}
          densities={[1, 2]}
          alt="Hannah Harrisonn"
          width="76"
          height="76"
        />
        <span aria-hidden="true">
          <LuSparkles size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
        </span>
      </div>
      <div>
        <p class="eyebrow">THE HUMAN BEHIND THE KEYBOARD</p>
        <h2>
          Software engineering by day.
          <br />A few side quests in between.
        </h2>
        <p>My background, experience, and a few ways to get in touch.</p>
      </div>
      <a class="action primary" href="/me/">
        More about me{" "}
        <LuArrowUpRight size="1em" className="ui-icon" aria-hidden="true" focusable="false" />
      </a>
    </section>
  </div>
</Layout>
