---
import { getCollection } from "astro:content";

import Redirect from "../../../../components/LegacyRedirect.astro";
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return [...new Set(posts.flatMap((post) => post.data.tags))].flatMap((tag) =>
    Array.from(
      { length: Math.ceil(posts.filter((post) => post.data.tags.includes(tag)).length / 10) },
      (_, i) => ({ params: { tag, page: i === 0 ? undefined : String(i + 1) } }),
    ),
  );
}
---

<Redirect target={"/feed/?tag=" + encodeURIComponent(Astro.params.tag!)} />
