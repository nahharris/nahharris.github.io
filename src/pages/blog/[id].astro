---
import Redirect from "../../components/LegacyRedirect.astro";
import { getOriginalPosts, originalPostId, legacyPostUrl, postUrl } from "../../lib/series";
export async function getStaticPaths() {
  return (await getOriginalPosts()).flatMap((post) =>
    [
      ...new Set([
        legacyPostUrl(post).slice(6),
        originalPostId(post),
        originalPostId(post) + ".md",
      ]),
    ].map((id) => ({
      params: { id },
      props: { target: postUrl(post) },
    })),
  );
}
const { target } = Astro.props;
---

<Redirect target={target} />
