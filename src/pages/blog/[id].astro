---
import { getCollection } from "astro:content";

import Redirect from "../../components/LegacyRedirect.astro";
import { legacyPostUrl, postUrl } from "../../lib/series";
export async function getStaticPaths() {
  return (await getCollection("posts")).flatMap((post) =>
    [...new Set([legacyPostUrl(post).slice(6), post.id, post.id + ".md"])].map((id) => ({
      params: { id },
      props: { target: postUrl(post) },
    })),
  );
}
const { target } = Astro.props;
---

<Redirect target={target} />
